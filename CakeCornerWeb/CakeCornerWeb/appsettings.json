{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "YOUR_CONNECTION_STRING"
  },

  "JwtOptions": {
    "SecretKey": "YOUR_SECRET_KEY_AT_LEAST_32_CHARS",
    "ExpiresHours": "12"
  }
}