@model ConstructorPage
@inject CakeCornerWeb.Services.IngredientImageService IngredientImages
@{
    ViewData["Title"] = "Конструктор тортів";
    string SelectedImage(int id, string type) => IngredientImages.ForIngredient(Model.Ingredients.FirstOrDefault(i => i.Ingredients_ID == id), type);
    var preview = new CustomCakeImageCards
    {
        Interactive = true,
        Cards = new[] {
            new IngredientImageCard("Biscuit", "Бісквіт", SelectedImage(Model.Request.BiscuitId, "Biscuit")),
            new IngredientImageCard("Cream", "Крем", SelectedImage(Model.Request.CreamId, "Cream")),
            new IngredientImageCard("Filling", "Начинка", SelectedImage(Model.Request.FillingId, "Filling"))
        }
    };
}
<div class="container mt-5">
    <h2 class="mb-3 text-primary">Створіть свій унікальний торт</h2>
    <p class="text-muted mb-4">Оберіть склад, вагу й оформлення. Ваші побажання будуть збережені разом із замовленням.</p>
    <form asp-controller="Constructor" asp-action="Add" method="post" id="customCakeForm">
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <div class="row">
            <div class="col-lg-7 mb-4">
                <div class="card mb-4 shadow-sm border-0">
                    <div class="card-header bg-light"><h5 class="mb-0">Крок 1. Базові параметри</h5></div>
                    <div class="card-body">
                        <div class="mb-3"><label asp-for="Request.GuestCount" class="form-label fw-bold">Кількість гостей</label><input asp-for="Request.GuestCount" type="number" min="1" max="50" class="form-control" /><small>Орієнтир — 200 г на гостя. Остаточну вагу можна змінити нижче.</small></div>
                        <div class="mb-3"><label asp-for="Request.Shape" class="form-label fw-bold">Форма торта</label><select asp-for="Request.Shape" class="form-select"><option value="Round">Кругла</option><option value="Square">Квадратна</option><option value="Heart">Серце</option></select></div>
                        <div class="mb-3">
                            <label asp-for="Request.Weight" class="form-label fw-bold">Вага, кг</label>
                            <input name="Request.Weight"
                                   id="Request_Weight"
                                   value="@(Model.Request.Weight > 0 ? Model.Request.Weight.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")"
                                   type="number"
                                   min="0.5"
                                   max="10"
                                   step="0.1"
                                   required
                                   class="form-control" />
                        </div>
                        <div class="mb-3"><label asp-for="Request.Quantity" class="form-label fw-bold">Кількість тортів</label><input asp-for="Request.Quantity" type="number" min="1" max="@CartLimits.MaxQuantity" required class="form-control" /></div>
                    </div>
                </div>
                <div class="card mb-4 shadow-sm border-0">
                    <div class="card-header bg-light"><h5 class="mb-0">Крок 2. Смак та текстура</h5></div>
                    <div class="card-body">
                        @foreach(var slot in new[] { ("BiscuitId", "Biscuit", "Бісквіт", Model.Request.BiscuitId), 
                        ("FillingId", "Filling", "Начинка", Model.Request.FillingId), 
                        ("CreamId", "Cream", "Крем", Model.Request.CreamId), 
                        ("MousseId", "Mousse", "Мус", Model.Request.MousseId) })
                        {
                            <div class="mb-3"><label for="@slot.Item1" class="form-label fw-bold">@slot.Item3</label>
                                <select name="Request.@slot.Item1" id="@slot.Item1" class="form-select component" required>
                                    <option value="">Оберіть компонент</option>
                                    @foreach(var ingredient in Model.Ingredients.Where(i => i.Type.IngredientsTypesName == slot.Item2))
                                    {<option value="@ingredient.Ingredients_ID" selected="@(slot.Item4 == ingredient.Ingredients_ID)" data-image="@Url.Content("~" + IngredientImages.ForIngredient(ingredient, slot.Item2))" data-price="@ingredient.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)">@ingredient.IngredientName — @ingredient.Price.ToString("0.00") грн/кг</option>}
                                </select>
                                <img id="preview-@slot.Item1" alt="@slot.Item3" width="100" height="80" class="mt-2 ingredient-choice-preview" data-ingredient-image data-fallback="@Url.Content("~" + CakeCornerWeb.Services.IngredientImageService.Placeholder)" hidden />
                            </div>
                        }
                    </div>
                </div>
                <div class="card mb-4 shadow-sm border-0">
                    <div class="card-header bg-light"><h5 class="mb-0">Крок 3. Декор та побажання</h5></div>
                    <div class="card-body">
                        <div class="mb-3"><label asp-for="Request.DesignNotes" class="form-label fw-bold">Побажання до оформлення</label><textarea asp-for="Request.DesignNotes" rows="3" maxlength="500" class="form-control"></textarea></div>
                        <div class="mb-3"><label asp-for="Request.Inscription" class="form-label fw-bold">Напис на торті</label><input asp-for="Request.Inscription" maxlength="50" class="form-control" /></div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card border-primary sticky-top" style="top:30px"><div class="card-body">
                    <h4 class="card-title text-center mb-4">Попередній розрахунок</h4>
                    @await Html.PartialAsync("_CustomCakeImages", preview)
                    <p>Рекомендована вага за кількістю гостей: <strong id="recommendedWeight">—</strong></p>
                    <p>Сума: <strong class="text-primary" id="customTotal">—</strong></p>
                    <p class="text-muted small">Ціна одного торта = сума тарифів обраних компонентів за кг × вага. Розрахунок не враховує додаткових платних послуг.</p>
                    <p class="alert alert-info small">Побажання до оформлення та бажану дату підтвердить кондитерська під час розгляду замовлення.</p>
                    <button type="submit" class="btn btn-primary btn-lg w-100 mt-2">Додати до кошика</button>
                </div></div>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    <script>
        const form = document.getElementById('customCakeForm');
        const guestInput = document.getElementById('Request_GuestCount');
        const weightInput = document.getElementById('Request_Weight');
        function updateCustomTotal() {
            const guests = Number(guestInput.value);
            document.getElementById('recommendedWeight').textContent = guests > 0 ? Math.max(0.5, Math.min(10, guests * 0.2)).toFixed(1) + ' кг' : '—';
            const selects = Array.from(form.querySelectorAll('.component'));
            for (const select of selects) {
                const preview = document.getElementById('preview-' + select.id);
                const path = select.selectedOptions[0]?.dataset.image;
                const valid = path && /^\/(?!\/)/.test(path) && !path.includes('..');
                preview.hidden = !valid;
                if (valid) preview.src = path; else preview.removeAttribute('src');
                const card = form.querySelector('[data-interactive="true"] [data-slot="' + select.id.replace(/Id$/, '') + '"] img');
                if (card) card.src = valid ? path : card.dataset.fallback;
            }
            if (selects.some(s => !s.value)) { document.getElementById('customTotal').textContent = '—'; return; }
            const rate = selects.reduce((sum, s) => sum + Number(s.selectedOptions[0].dataset.price), 0);
            const total = Math.round((rate * Number(weightInput.value) + Number.EPSILON) * 100) / 100 * Number(document.getElementById('Request_Quantity').value);
            document.getElementById('customTotal').textContent = Number.isFinite(total) ? total.toFixed(2) + ' грн' : '—';
        }
        guestInput.addEventListener('change', () => { if (Number(guestInput.value) > 0) weightInput.value = Math.max(0.5, Math.min(10, Number(guestInput.value) * 0.2)).toFixed(1); updateCustomTotal(); });
        form.addEventListener('input', updateCustomTotal);
        form.addEventListener('change', updateCustomTotal);
        updateCustomTotal();
    </script>
}
