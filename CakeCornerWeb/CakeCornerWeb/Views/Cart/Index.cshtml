@model CakeCornerWeb.Models.Entities.Cart
@inject CakeCornerWeb.Services.IngredientImageService IngredientImages

@{
    ViewData["Title"] = "Кошик";
    var totalAmount = Model.CartItems.Sum(i => i.Price * i.Quantity) + Model.CustomItems.Sum(i => i.UnitPrice * i.Quantity);
}

<div class="container my-4">
    <h2>Ваш кошик</h2>

    @if (TempData["CartSuccess"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }

     @if (TempData["CartError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <p class="text-muted">Ціни готових тортів оновлюються з каталогу. Ціна кастомного торта розраховується при додаванні конфігурації.</p>

    @if (!Model.CartItems.Any() && !Model.CustomItems.Any())
    {
        <div class="alert alert-info mt-3">
            Ваш кошик порожній. <a asp-controller="Cake" asp-action="Index">Перейти до вибору тортів</a>.
        </div>
    }
    else
    {
        <div class="table-responsive">
        <table class="table align-middle mt-3">
            <thead>
                <tr>
                    <th>Торт</th>
                    <th>Вага</th>
                    <th>Ціна</th>
                    <th>Кількість</th>
                    <th>Сума</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.CartItems)
                {
                    <tr>
                        <td>
                            <strong>@item.CakeWeight?.Cake?.CakeName</strong>
                        </td>
                        <td>@item.CakeWeight?.WeightOption?.Weight кг</td>
                        <td>@item.Price.ToString("0.00") грн</td>
                        <td>
                            <form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="d-flex gap-2 align-items-center">
                                <input type="hidden" name="cartItemId" value="@item.CartItem_ID" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1"
                                       max="@CartLimits.MaxQuantity" required class="form-control form-control-sm"
                                       style="width: 5rem" aria-label="Кількість: @item.CakeWeight?.Cake?.CakeName" />
                                <button type="submit" class="btn btn-outline-primary btn-sm">Оновити</button>
                            </form>
                        </td>
                        <td>@((item.Price * item.Quantity).ToString("0.00")) грн</td>
                        <td>
                            <form asp-controller="Cart" asp-action="Remove" method="post">
                                <input type="hidden" name="cartItemId" value="@item.CartItem_ID" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">Видалити</button>
                            </form>
                        </td>
                    </tr>
                }
                @foreach (var item in Model.CustomItems)
                {
                    <tr>
                        <td class="custom-cake-summary">
                            <strong>Кастомний торт</strong>
                            @await Html.PartialAsync("_CustomCakeImages", CustomCakeImageCards.ForItem(item, IngredientImages))
                            <p>@item.CustomCake.ConfigurationDescription</p>
                            @if(!string.IsNullOrWhiteSpace(item.CustomCake.Inscription)){<p>Напис: @item.CustomCake.Inscription</p>}
                        </td>
                        <td>@item.CustomCake.Weight кг</td><td>@item.UnitPrice.ToString("0.00") грн</td>
                        <td>
                            <form asp-controller="Constructor" asp-action="UpdateQuantity" method="post" class="d-flex gap-2">
                                <input type="hidden" name="cartItemId" value="@item.CustomCakeCart_ID" />
                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="@CartLimits.MaxQuantity" required class="form-control" aria-label="Кількість кастомних тортів" />
                                <button class="btn btn-outline-primary btn-sm" type="submit">Оновити</button>
                            </form>
                        </td>
                        <td>@((item.UnitPrice * item.Quantity).ToString("0.00")) грн</td>
                        <td><form asp-controller="Constructor" asp-action="Remove" method="post"><input type="hidden" name="cartItemId" value="@item.CustomCakeCart_ID" /><button class="btn btn-outline-danger btn-sm" type="submit">Видалити</button></form></td>
                    </tr>
                }
            </tbody>
        </table>
        </div>

        <div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mt-4">
            <h4>Разом: <strong>@totalAmount.ToString("0.00") грн</strong></h4>
            <div class="cart-actions">
                <form asp-controller="Cart" asp-action="Clear" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-secondary me-2">Очистити</button>
                </form>
                 <a asp-controller="Orders" asp-action="Checkout" class="btn btn-success btn-lg">Оформити замовлення</a>
            </div>
        </div>
    }
</div>
