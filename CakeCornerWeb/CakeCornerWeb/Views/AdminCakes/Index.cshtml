@model CatalogListPage<CakeCornerWeb.Models.Entities.Cake>
@{ ViewData["Title"] = "Керування тортами"; }
@await Html.PartialAsync("_AdminNavigation")
<div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3"><h1>Готові торти</h1><a asp-action="Create" class="btn btn-primary">Додати торт</a></div>
<div class="d-flex gap-2 mb-3">
    <a asp-action="Index" class="btn @(!Model.Archived ? "btn-primary" : "btn-outline-primary")">У каталозі</a>
    <a asp-action="Index" asp-route-archived="true" class="btn @(Model.Archived ? "btn-primary" : "btn-outline-primary")">Архів</a>
</div>
<form method="get" class="d-flex gap-2 mb-3"><input type="hidden" name="archived" value="@Model.Archived.ToString().ToLowerInvariant()" /><input type="search" name="query" value="@Model.Query" maxlength="100" placeholder="Пошук за назвою" aria-label="Пошук тортів" class="form-control" /><button class="btn btn-outline-primary">Знайти</button></form>
@if (!Model.Items.Any()) { <p class="alert alert-info">Тортів не знайдено.</p> }
else
{
    <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Фото</th><th>Торт</th><th>Категорія / смаки</th><th>Варіанти ваги</th><th>Дії</th></tr></thead><tbody>
    @foreach(var item in Model.Items)
    {
        <tr><td><img src="@Url.Content(item.ImagePath)" alt="@item.CakeName" width="80" height="65" style="object-fit:cover;border-radius:8px" loading="lazy" /></td>
        <td><strong>@item.CakeName</strong><div class="small text-muted">@item.DescriptionShort</div></td><td>@item.Category.CategoryName<partial name="_CakeFlavorTags" model="item.CakeFlavors.OrderBy(cf => cf.Flavor.FlavorName).Select(cf => cf.Flavor.FlavorName)" /></td><td>@item.CakeWeights.Count(v => v.IsActive)</td>
        <td><div class="d-flex flex-wrap gap-2">
        @if (Model.Archived)
        {
            <form asp-action="Restore" asp-route-id="@item.Cake_ID" method="post"><input type="hidden" name="RowVersion" value="@Convert.ToBase64String(item.RowVersion)" /><button class="btn btn-outline-success btn-sm">Відновити</button></form>
        }
        else
        {
            <a asp-action="Edit" asp-route-id="@item.Cake_ID" class="btn btn-outline-primary btn-sm">Редагувати</a>
            <a asp-action="Delete" asp-route-id="@item.Cake_ID" class="btn btn-outline-danger btn-sm">Видалити</a>
        }
        </div></td></tr>
    }
    </tbody></table></div>
}
<nav aria-label="Сторінки тортів" class="d-flex gap-3 align-items-center">
    @if(Model.Page > 1){<a asp-route-page="@(Model.Page - 1)" asp-route-query="@Model.Query" asp-route-archived="@Model.Archived" class="btn btn-outline-secondary">Назад</a>}
    @if(Model.TotalPages > 0){<span>@Model.Page / @Model.TotalPages</span>}
    @if(Model.Page < Model.TotalPages){<a asp-route-page="@(Model.Page + 1)" asp-route-query="@Model.Query" asp-route-archived="@Model.Archived" class="btn btn-outline-secondary">Далі</a>}
</nav>
