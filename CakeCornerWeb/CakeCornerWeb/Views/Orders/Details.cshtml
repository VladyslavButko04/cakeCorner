@model OrderDetailsPage
@using CakeCornerWeb.Services
@inject CakeCornerWeb.Services.IngredientImageService IngredientImages
@{ var order = Model.Order; ViewData["Title"] = $"Замовлення #{order.Order_ID}"; var version = Convert.ToBase64String(order.RowVersion); }
@if (Model.IsAdmin) { @await Html.PartialAsync("_AdminNavigation") }
<h1>Замовлення #@order.Order_ID</h1>
@if(TempData["OrderSuccess"] is string success){<p class="alert alert-success" role="status">@success</p>}
@if(TempData["OrderError"] is string error){<p class="alert alert-danger" role="alert">@error</p>}
<p><strong>Статус:</strong> @OrderWorkflow.Label(order.Status.Code)</p>
<p><strong>Створено:</strong> @OrderService.InKyiv(order.CreatedAt).ToString("dd.MM.yyyy HH:mm") (Київ)</p>
<p><strong>Бажана видача:</strong> @order.DeliveryDateTime.ToString("dd.MM.yyyy HH:mm") (Київ)</p>
<p><strong>Пункт видачі:</strong> @order.PickupLocation.City.CityName, @order.PickupLocation.Address</p>
<p><strong>Клієнт:</strong> @order.Person.Name; @order.PhoneNumber</p>
@if(order.RequiredCallback){<p>Потрібен дзвінок для уточнення.</p>}
@if(!string.IsNullOrWhiteSpace(order.Comment)){<p><strong>Коментар:</strong> @order.Comment</p>}
<div class="table-responsive">
    <table class="table"><thead><tr><th>Торт / склад</th><th>Вага</th><th>Кількість</th><th>Ціна</th><th>Сума</th></tr></thead><tbody>
        @foreach(var item in order.Items)
        {<tr><td>@(item.CakeNameSnapshot ?? item.CakeWeight.Cake.CakeName)</td><td>@(item.WeightSnapshot ?? item.CakeWeight.WeightOption.Weight) кг</td><td>@item.Quantity</td><td>@item.ItemPrice.ToString("0.00") грн</td><td>@((item.ItemPrice * item.Quantity).ToString("0.00")) грн</td></tr>}
        @foreach(var item in order.CustomItems)
        {<tr><td class="custom-cake-summary"><strong>Кастомний торт</strong>
            @await Html.PartialAsync("_CustomCakeImages", CustomCakeImageCards.ForItem(item, IngredientImages))
            <p>@(item.DescriptionSnapshot ?? item.CustomCake.ConfigurationDescription)</p></td><td>@(item.WeightSnapshot ?? item.CustomCake.Weight) кг</td><td>@item.Quantity</td><td>@item.UnitPrice.ToString("0.00") грн</td><td>@((item.UnitPrice * item.Quantity).ToString("0.00")) грн</td></tr>}
    </tbody></table>
</div>
<h3>Разом: @order.TotalPrice.ToString("0.00") грн</h3>
<p>Оплачено: @((order.Payment?.PaidAmount ?? 0).ToString("0.00")) грн.</p>
<p>До оплати: @Math.Max(0, order.TotalPrice - (order.Payment?.PaidAmount ?? 0)).ToString("0.00") грн.</p>
@if(order.CheckoutToken != null){<p>Оплата при отриманні.</p>}
@if(order.Payment?.IsOnlinePaid == true){<p>Зафіксована онлайн-оплата: @order.Payment.OnlineAmount.ToString("0.00") грн.</p>}
@if(Model.IsAdmin)
{
    <h2 class="mt-4">Обробка замовлення</h2>
    @if(OrderWorkflow.Next(order.Status.Code).Any())
    {
        <form asp-controller="AdminOrders" asp-action="ChangeStatus" asp-route-id="@order.Order_ID" method="post" class="col-lg-7">
            <input name="rowVersion" type="hidden" value="@version" />
            <label for="statusCode">Новий статус</label>
            <select name="statusCode" id="statusCode" class="form-select mb-2">
                @foreach(var next in OrderWorkflow.Next(order.Status.Code)){<option value="@next">@OrderWorkflow.Label(next)</option>}
            </select>
            <label for="reason">Коментар (обов'язковий для скасування / відхилення)</label>
            <textarea name="reason" id="reason" maxlength="500" class="form-control mb-2"></textarea>
            <button type="submit" class="btn btn-primary">Змінити статус</button>
        </form>
    }
    @if(order.Status.Code == OrderWorkflow.Ready && order.Payment?.IsFinalPaid != true)
    {
        <form asp-controller="AdminOrders" asp-action="MarkPaid" asp-route-id="@order.Order_ID" method="post" class="mt-3">
            <input name="rowVersion" type="hidden" value="@version" />
            <button type="submit" class="btn btn-success">Підтвердити отримання @Math.Max(0, order.TotalPrice - (order.Payment?.PaidAmount ?? 0)).ToString("0.00") грн</button>
        </form>
    }
}
else if(OrderWorkflow.CanCancel(order.Status.Code))
{
    <form asp-action="Cancel" asp-route-id="@order.Order_ID" method="post" class="col-lg-7 mt-4">
        <input name="rowVersion" type="hidden" value="@version" /><input name="statusCode" type="hidden" value="Cancelled" />
        <label for="reason">Причина скасування</label><textarea name="reason" id="reason" maxlength="500" required class="form-control mb-2"></textarea>
        <button type="submit" class="btn btn-outline-danger">Скасувати замовлення</button>
    </form>
}
<h2 class="mt-4">Історія змін</h2>
@if(!order.History.Any()){<p>Зміни статусу ще не зафіксовано.</p>}
<ul>
    @foreach(var entry in order.History.OrderBy(h => h.ChangedAt).ThenBy(h => h.Id))
    {<li>@OrderService.InKyiv(entry.ChangedAt).ToString("dd.MM.yyyy HH:mm") — @OrderWorkflow.Label(entry.ToCode). @entry.Note</li>}
</ul>
<a asp-controller="@(Model.IsAdmin ? "AdminOrders" : "Orders")" asp-action="Index" class="btn btn-outline-secondary">До списку замовлень</a>
