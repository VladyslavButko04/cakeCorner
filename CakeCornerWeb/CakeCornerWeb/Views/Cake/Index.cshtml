@using CakeCornerWeb.Models
@model CakeCatalogPage

@{
    var searchQuery = Model.Filters.Search;
    var catalogAction = searchQuery != null ? "Search" : "Index";
    ViewData["Title"] = searchQuery != null ? "Результати пошуку" : "Список тортів";
}

@section Styles {
    <link rel="stylesheet" href="~/css/cakes.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/recommendations.css" asp-append-version="true" />
}

@if (searchQuery != null)
{
    <div class="alert alert-info d-flex justify-content-between align-items-center mb-4">
        <span>Результати пошуку за запитом: <strong>@searchQuery</strong></span>
        <a href="@Url.Action("Index", "Cake")" class="btn btn-sm btn-outline-secondary">Повернутися до каталогу</a>
    </div>
}

@await Html.PartialAsync("_RecommendationPanel", "Ready")

<h2 class="mb-4">🍰 Наші торти</h2>

@{
    var formFilterModel = Model.Filters;
}

<form asp-controller="Cake" asp-action="@catalogAction" method="get" class="mb-4" id="filterForm">
    <input type="hidden" name="page" value="1" />
    @if (searchQuery != null)
    {
        <input type="hidden" name="query" value="@searchQuery" />
    }
    <div class="row g-3 align-items-center">
        <div class="col-md-4">
            <select name="categoryId" class="form-select" aria-label="Категорія торта" onchange="submitForm()">
                @foreach (var item in formFilterModel.Categories)
                {
                    <option value="@item.Value" selected="@(item.Value == formFilterModel.CategoryId?.ToString())">
                        @item.Text
                    </option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <select name="flavorId" class="form-select" aria-label="Смак торта" onchange="submitForm()">
                @foreach (var item in formFilterModel.Flavors)
                {
                    <option value="@item.Value" selected="@(item.Value == formFilterModel.FlavorId?.ToString())">
                        @item.Text
                    </option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <a href="@Url.Action("Index", "Cake")" class="btn btn-outline-danger" id="resetFiltersBtn" hidden="@(!formFilterModel.CategoryId.HasValue && !formFilterModel.FlavorId.HasValue && searchQuery == null)">
                🚫 Прибрати фільтри
            </a>
        </div>
    </div>
</form>

@if (Model.Items.Any())
{
    <p class="catalog-results text-muted">Показано @Model.FirstItem–@Model.LastItem з @Model.TotalCount тортів</p>
    <div class="row" id="catalog-cakes">
        @foreach (var cake in Model.Items)
        {
            var validWeights = cake.CakeWeights.Where(w => w.WeightOption != null && w.IsActive).ToList();
            var hasWeights = validWeights.Any();

            var minWeight = hasWeights ? validWeights.Min(w => w.WeightOption.Weight) : 0;
            var minPrice = hasWeights ? validWeights.Min(w => w.Price) : 0;

            <div class="col-md-4 mb-4">
                <div class="custom-cake-card">
                    <img src="@cake.ImagePath" alt="@cake.CakeName" class="cake-image img-fluid" />
                    <h5 class="cake-title">@cake.CakeName</h5>
                    <partial name="_CakeFlavorTags" model="cake.CakeFlavors.OrderBy(cf => cf.Flavor.FlavorName).Select(cf => cf.Flavor.FlavorName)" />
                    <p class="cake-desc">@cake.DescriptionShort</p>
                    @if (hasWeights)
                    {
                        <p class="cake-weight-price">
                            <span>@minWeight.ToString("0.00") кг</span>
                            <span>@minPrice.ToString("0.00") грн</span>
                        </p>
                    }
                    else
                    {
                        <p class="cake-weight-price text-warning">Ціна не вказана</p>
                    }

                    <a asp-controller="Cake" asp-action="Details" asp-route-id="@cake.Cake_ID" class="cake-btn">
                        Переглянути
                    </a>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-warning mt-4 text-center" role="alert">
        🧐 Нажаль, тортів за заданими параметрами не знайдено.
    </div>
}

<partial name="_CatalogPagination" model="Model" />

@section Scripts {
    <script src="~/js/recommendations.js" asp-append-version="true" defer></script>
    <script>
        function submitForm() {
            document.getElementById("filterForm").submit();
        }
    </script>
}
