@using CakeCornerWeb.Models
@model List<CakeCornerWeb.Models.Entities.Cake>

@{
    ViewData["Title"] = ViewData["SearchQuery"] != null ? "Результати пошуку" : "Список тортів";
}

@section Styles {
    <link rel="stylesheet" href="~/css/cakes.css" />
}

@if (ViewData["SearchQuery"] != null)
{
    <div class="alert alert-info d-flex justify-content-between align-items-center mb-4">
        <span>Результати пошуку за запитом: <strong>@ViewData["SearchQuery"]</strong></span>
        <a href="@Url.Action("Index", "Cake")" class="btn btn-sm btn-outline-secondary">Повернутися до каталогу</a>
    </div>
}

<h2 class="mb-4">🍰 Наші торти</h2>

@{
    var formFilterModel = ViewBag.FilterModel as CakeCornerWeb.Models.CakeFilterViewModel;
}

@if (formFilterModel != null && formFilterModel.Categories != null && formFilterModel.Flavors != null)
{
    <form method="get" class="mb-4" id="filterForm">
        <div class="row g-3 align-items-center">
            <div class="col-md-4">
                <select name="categoryId" class="form-select" onchange="submitForm()">
                    @foreach (var item in formFilterModel.Categories)
                    {
                        <option value="@item.Value" selected="@(item.Value == formFilterModel.CategoryId?.ToString())">
                            @item.Text
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <select name="flavorId" class="form-select" onchange="submitForm()">
                    @foreach (var item in formFilterModel.Flavors)
                    {
                        <option value="@item.Value" selected="@(item.Value == formFilterModel.FlavorId?.ToString())">
                            @item.Text
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <a href="@Url.Action("Index", "Cake")" class="btn btn-outline-danger" id="resetFiltersBtn">
                    🚫 Прибрати фільтри
                </a>
            </div>
        </div>
    </form>
}

@if (Model != null && Model.Any())
{
    <div class="row">
        @foreach (var cake in Model)
        {
            var validWeights = cake.CakeWeights?.Where(w => w.WeightOption != null).ToList();
            var hasWeights = validWeights != null && validWeights.Any();

            var minWeight = hasWeights ? validWeights.Min(w => w.WeightOption.Weight) : 0;
            var minPrice = hasWeights ? validWeights.Min(w => w.Price) : 0;

            <div class="col-md-4 mb-4">
                <div class="custom-cake-card">
                    <img src="@cake.ImagePath" alt="@cake.CakeName" class="cake-image img-fluid" />
                    <h5 class="cake-title">@cake.CakeName</h5>
                    <p class="cake-desc">@cake.DescriptionShort</p>
                    @if (hasWeights)
                    {
                        <p class="cake-weight-price">
                            <span>@minWeight.ToString("0.00") кг</span>
                            <span>@minPrice.ToString("0.00") грн</span>
                        </p>
                    }
                    else
                    {
                        <p class="cake-weight-price text-warning">Ціна не вказана</p>
                    }

                    <a asp-controller="Cake" asp-action="Details" asp-route-id="@cake.Cake_ID" class="cake-btn">
                        Переглянути
                    </a>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-warning mt-4 text-center" role="alert">
        🧐 Нажаль, тортів за заданими параметрами не знайдено.
    </div>
}

@section Scripts {
    @{
        var scriptFilterModel = ViewBag.FilterModel as CakeCornerWeb.Models.CakeFilterViewModel;
    }

    @if (scriptFilterModel != null)
    {
        <script>
            window.onload = function () {
                const categoryId = "@scriptFilterModel.CategoryId";
                const flavorId = "@scriptFilterModel.FlavorId";

                const resetBtn = document.getElementById("resetFiltersBtn");

                if (categoryId || flavorId) {
                    resetBtn.style.display = "inline-block";
                } else {
                    resetBtn.style.display = "none";
                }
            };

            function submitForm() {
                document.getElementById("filterForm").submit();
            }
        </script>
    }
}