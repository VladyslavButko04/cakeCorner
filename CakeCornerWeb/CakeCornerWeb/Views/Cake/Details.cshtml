@model CakeDetailViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/detail.css" />
}

<div class="cake-details">
    <div class="cake-image">
        <img src="@Model.ImagePath" alt="@Model.CakeName" class="cake-details-image" />

        <div class="info-overlay">
            <h1>@Model.CakeName</h1>
            <p>@Model.DescriptionLong</p>

            <form asp-controller="Cart" asp-action="Add" method="post">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
                    <div class="weight-select-wrapper">
                        <label class="form-label">Вага:</label>
                        <select name="cakeWeightId" id="weightSelect" class="form-select form-select-sm" onchange="updatePrice()">
                            @foreach (var weight in Model.Weights)
                            {
                                <option value="@weight.CakeWeightId" data-price="@weight.Price">@weight.Weight кг</option>
                            }
                        </select>
                    </div>

                    <div class="quantity-wrapper">
                        <label class="form-label">Кількість:</label>
                        <div class="d-flex align-items-center">
                            <button type="button" class="quantity-btn" onclick="changeQuantity(-1)">–</button>
                            <input type="number" name="quantity" id="quantity" value="1" min="1" max="99" readonly />
                            <button type="button" class="quantity-btn" onclick="changeQuantity(1)">+</button>
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3">
                    <div class="d-flex flex-column align-items-start">
                        <label class="form-label mb-1">Ціна:</label>
                        <span id="priceDisplay" class="fw-semibold text-primary small">
                            @Model.Weights.First().Price грн
                        </span>
                    </div>

                    <div class="d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary">Додати до кошика</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function changeQuantity(delta) {
            const input = document.getElementById("quantity");
            let value = parseInt(input.value);
            if (!isNaN(value)) {
                value += delta;
                if (value < 1) value = 1;
                input.value = value;
                updatePrice();
            }
        }

        function updatePrice() {
            const select = document.getElementById("weightSelect");
            const quantity = parseInt(document.getElementById("quantity").value) || 1;
            const selectedOption = select.options[select.selectedIndex];
            const unitPrice = parseFloat(selectedOption.getAttribute("data-price")) || 0;
            const totalPrice = (unitPrice * quantity).toFixed(2);

            const priceDisplay = document.getElementById("priceDisplay");
            priceDisplay.textContent = `${totalPrice} грн`;
        }

        document.addEventListener("DOMContentLoaded", () => {
            document.getElementById("quantity").addEventListener("input", updatePrice);
        });
    </script>
}